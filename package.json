{
  "name": "molscrub_viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel pyserver dev:npm",
    "dev:npm": "vite",
    "pyserver": "python server.py",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "tsc -p tsconfig.node.json",
    "electron:start": "npm run electron:build && electron dist-electron/electron/main.js",
    "start": "npm-run-all --parallel dev:npm electron:start",
    "dist": "vite build && npm run electron:build && electron-builder"
  },
  "build": {
    "appId": "com.molscrub.viewer",
    "productName": "MolScrubViewer",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server.py"
    ],
    "asar": false,
    "mac": {
      "target":"dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@loschmidt/jsme-react": "^1.0.2",
    "3dmol": "^2.4.2",
    "express": "^4.21.2",
    "jsme-editor": "^2023.7.31",
    "path": "^0.12.7",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-resizable-panels": "^2.1.7"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.2",
    "@eslint/js": "^9.19.0",
    "@types/electron": "^1.4.38",
    "@types/react": "^18.0.8",
    "@types/react-dom": "^18.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
